<?xml version="1.0" encoding="utf-8"?>
<!-- Widget settings: live preview over the wallpaper, controls in a glass bottom sheet. Colours are set in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#26000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="24dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_preview"
            android:scaleType="fitCenter" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingTop="10dp"
                android:paddingRight="18dp"
                android:paddingBottom="20dp">

                <View
                    android:id="@+id/handle"
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-light"
                    android:text="@string/widget_settings_title"
                    android:textSize="28sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/transparency_label"
                        style="@style/WidgetSettingsLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/widget_transparency" />

                    <TextView
                        android:id="@+id/transparency_value"
                        style="@style/WidgetSettingsLabel"
                        android:layout_width="wrap_content" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/transparency"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@string/widget_transparency"
                    android:max="100" />

                <TextView
                    android:id="@+id/theme_label"
                    style="@style/WidgetSettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/widget_theme" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/theme_app"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/widget_theme_app" />

                    <Button
                        android:id="@+id/theme_light"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:text="@string/widget_theme_light" />

                    <Button
                        android:id="@+id/theme_dark"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:text="@string/widget_theme_dark" />
                </LinearLayout>

                <TextView
                    android:id="@+id/habit_label"
                    style="@style/WidgetSettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/widget_habit" />

                <HorizontalScrollView
                    android:id="@+id/habit_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/habit_list"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/cancel"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/widget_cancel" />

                    <Button
                        android:id="@+id/save"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:text="@string/widget_save" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
